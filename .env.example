# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/otakademi_app?schema=public"

# ---------------------------------------------------------------------------
# Auth - signs admin session cookies. Rotating this logs everyone out.
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-with-openssl-rand-base64-48"

# Seed credentials for the first Super Admin (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@otakademi.id"
SEED_ADMIN_PASSWORD="change-me"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

PAYMENT_WEBHOOK_SECRET="shared-secret-from-your-payment-provider"
