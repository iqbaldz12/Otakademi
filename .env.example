# ===========================================================================
# CONTOH ENV UNTUK DEVELOPMENT LOKAL
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# ===========================================================================

# --- Database (lokal) ---
# Kalau pakai Docker Compose lokal, host = "db". Kalau Postgres di mesin
# sendiri (tanpa Docker), pakai 127.0.0.1.
DATABASE_URL="postgresql://otakademi:otakademi@127.0.0.1:5432/otakademi_app?schema=public"

# Dipakai service Postgres di docker-compose (lokal).
POSTGRES_USER="otakademi"
POSTGRES_PASSWORD="otakademi"
POSTGRES_DB="otakademi_app"

# --- Auth ---
# Kunci penanda tangan cookie sesi admin. WAJIB acak & panjang.
# Buat dengan:  openssl rand -base64 48
AUTH_SECRET="ganti-dengan-hasil-openssl-rand-base64-48"

# Akun Super Admin pertama (dibuat saat seed).
SEED_ADMIN_EMAIL="admin@otakademi.id"
SEED_ADMIN_PASSWORD="change-me"

# --- Situs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payment gateway (opsional saat lokal) ---
PAYMENT_WEBHOOK_SECRET="shared-secret-from-your-payment-provider"

# Isi data contoh saat container pertama kali up (Docker). true/false.
RUN_SEED="true"

# --- Email (SMTP) untuk kirim tiket ke peserta ---
# Kosongkan semua SMTP_* untuk mode "log" (email ditulis ke terminal, tidak
# benar-benar dikirim) sehingga alur tetap bisa diuji tanpa server email.
# Contoh Gmail: aktifkan 2FA, buat "App Password", lalu isi:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=akun@gmail.com,
#   SMTP_PASS=app-password-16-karakter
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Otakademi <no-reply@otakademi.id>"
